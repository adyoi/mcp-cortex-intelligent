{
  "name": "mcp-cortex-intelligent",
  "version": "1.1.0",
  "description": "Cortex Intelligent MCP server: make ordinary LLMs smarter via offline cognitive augmentation. No API keys.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist/index.js",
    "dist/cli.js",
    "dist/env.js",
    "dist/mcp",
    "dist/db",
    "dist/knowledge",
    "dist/memory",
    "dist/session",
    "dist/provisioner",
    "dist/model",
    "dist/cognitive",
    "dist/decision",
    "dist/procedures",
    "dist/plantask",
    "dist/system",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/adyoi/mcp-cortex-intelligent.git"
  },
  "bugs": {
    "url": "https://github.com/adyoi/mcp-cortex-intelligent/issues"
  },
  "homepage": "https://github.com/adyoi/mcp-cortex-intelligent#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "offline",
    "cognitive",
    "guardrails",
    "memory",
    "knowledge",
    "agent",
    "skill",
    "opencode",
    "llm",
    "augmentation"
  ],
  "bin": {
    "mcp-cortex-intelligent": "dist/index.js",
    "mcp-cortex-intelligent-cli": "dist/cli.js"
  },
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "oxlint src scripts .opencode/plugins --deny-warnings",
    "clean-db": "tsx scripts/clean-all.ts",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "test": "tsx src/test/test-all.ts",
    "setup-clients": "node scripts/setup-clients.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "oxlint": "^1.83.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.0.0",
    "playwright": "^1.64.1"
  }
}
