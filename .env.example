# Cortex Intelligent MCP
CORTEX_DB_DIR=.cortex-data
CORTEX_MODEL=
CORTEX_TIER_OVERRIDE=
CORTEX_VERIFY_ALLOWLIST=npm test,npm run lint,npm run typecheck
CORTEX_VERIFY_TIMEOUT_MS=300000
CORTEX_SELF_CRITIQUE_THRESHOLD=0.8
CORTEX_SELF_CRITIQUE_MAX_ITERS=3
CORTEX_AUTO_CONSOLIDATE=1
CORTEX_PROVISION_BACKUP=1
CORTEX_GUARDRAILS_STRICT=1
CORTEX_VERIFY_CWD=
CORTEX_LOG_LEVEL=info

# Embedding (reuse)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
SEARCH_MODE=hybrid
KB_MEMORY_HALF_LIFE_DAYS=14
KB_PRUNE=0
KB_VECTOR_CACHE_WARN_MB=256
KB_SESSION_MAX_MSGS=500
KB_SESSION_CONDENSE=1
KB_SESSION_CONDENSE_MIN_CHARS=120
KB_SESSION_CONDENSE_RATIO=0.35